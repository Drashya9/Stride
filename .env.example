# ---------- Database ----------
# Local: the Docker Postgres from docker-compose.yml
DATABASE_URL=postgres://stride:stride@localhost:5433/stride
# Neon: set DATABASE_URL to the *pooled* string and this to the direct one (used for migrations)
# DATABASE_URL_UNPOOLED=
TEST_DATABASE_URL=postgres://stride:stride@localhost:5433/stride_test

# ---------- Auth.js ----------
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_TRUST_HOST=true
# OAuth providers are enabled only when both values are set.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Email-only "dev login" for local work and Playwright. NEVER enable on a public deployment.
ALLOW_DEV_LOGIN=true

# ---------- App ----------
APP_URL=http://localhost:3000
# Comma-separated emails that can open /admin
ADMIN_EMAILS=alice@stride.test

# ---------- Email (optional) ----------
# Without email set up, invites show a copyable link instead.
# Option A — send from your Gmail (free, ~500/day). Needs 2-Step Verification + an App Password:
#   https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Option B — Resend (needs a verified domain to email other people)
RESEND_API_KEY=
EMAIL_FROM=Stride <invites@example.com>

# ---------- Metrics ----------
# Fraction of client actions that report timings (1 = all, 0.2 = 20%)
NEXT_PUBLIC_METRICS_SAMPLE_RATE=1
